# Copy to .env.local. Never commit credentials.
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://researchos:researchos@localhost:5432/researchos
DATABASE_SSL=false
DB_POOL_SIZE=10
# Required for summaries, embeddings, research chat, and comparison.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_CHAT_MODEL=gpt-4.1-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY is accepted as an alternative to AI_API_KEY.
ALLOW_REGISTRATION=true
